# ── gRPC server ───────────────────────────────────────────────────────────────
PORT=50051
LOG_LEVEL=info

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Leave empty to run without Redis (single-instance mode, no cross-pod fan-out).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── PostgreSQL (rooms, members, activity) ─────────────────────────────────────
# Must point to the SAME database instance used by user_service.
# user_service env vars: DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
POSTGRES_DB=zpc_db
POSTGRES_SSLMODE=disable

# ── MongoDB (message history) ─────────────────────────────────────────────────────────
# Leave MONGO_URI empty to disable persistent message history.
# Free tier (Atlas M0):  mongodb+srv://user:pass@cluster0.mongodb.net
# Local:                 mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=zpc_chat

# ── MinIO / S3-compatible storage (optional) ──────────────────────────────────
# Leave MINIO_ENDPOINT empty to disable file and image sharing.
# For local dev: docker compose up starts MinIO at localhost:9000
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat-media
MINIO_USE_SSL=false

# ── AWS S3 (production alternative to MinIO) ──────────────────────────────────
# Set STORAGE_BACKEND=s3 to use real AWS S3 or any S3-compatible service.
# S3_ENDPOINT is optional — leave empty for real AWS, set for R2/Spaces/B2.
# STORAGE_BACKEND=s3
# S3_BUCKET=chat-media
# S3_REGION=us-east-1
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Kafka (optional, replaces Redis pub/sub for 10M+ users) ──────────────────
# Leave KAFKA_BROKERS empty to use Redis pub/sub.
KAFKA_BROKERS=
KAFKA_TOPIC=chat-messages
KAFKA_GROUP_ID=chat-service

# ── JWT auth (RS256) ──────────────────────────────────────────────────────────
# Point to the SAME public.pem used by user_service to issue tokens.
# Copy user_service/config/public.pem → chat_service/config/public.pem
# audience and issuer must match what user_service puts in JWT claims.
JWT_PUBLIC_KEY_PATH=config/public.pem
JWT_AUDIENCE=graphql-api
JWT_ISSUER=ZPC
# Set JWT_DISABLED=true ONLY for local dev when running without user_service.
JWT_DISABLED=false
